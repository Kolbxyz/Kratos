---
import "../styles/global.css";
import Forme from "../components/Forme.astro";
import Progression from "../components/Progression.astro";
interface Props { titre: string; description: string }
const { titre, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const ici = Astro.url.pathname;
const nav = [
  { href: base, nom: "Parcours" },
  { href: `${base}bibliotheque/`, nom: "Bibliothèque" },
  { href: `${base}recherche/`, nom: "Recherche" },
  { href: `${base}app/index.html`, nom: "Entraînement" },
  { href: `${base}a-propos/`, nom: "À propos" },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Roboto+Flex:opsz,wdth,wght@8..144,100..151,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={base}><Forme nom="biscuit" />Kratos</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={ici === n.href || (n.href !== base && ici.startsWith(n.href)) ? "page" : undefined}>{n.nom}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        Chaque chiffre renvoie à sa source, avec sa date de consultation. Données ouvertes : Eurostat, Banque mondiale (SIPRI), Assemblée nationale.
        Une erreur ? Signalez-la sur le dépôt du projet.
      </div>
    </footer>
    <Progression />
  </body>
</html>
