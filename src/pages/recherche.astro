---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base titre="Recherche · Kratos" description="Rechercher dans toutes les leçons.">
  <div class="wrap">
    <h1>Recherche</h1>
    <link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet" />
    <div id="search"></div>
    <noscript>La recherche nécessite JavaScript.</noscript>
    <script is:inline define:vars={{ base }}>
      const s = document.createElement("script");
      s.src = `${base}pagefind/pagefind-ui.js`;
      s.onload = () => new PagefindUI({ element: "#search", showSubResults: true, translations: { placeholder: "Rechercher une notion, un auteur, une date" } });
      s.onerror = () => { document.getElementById("search").textContent = "L'index de recherche n'est disponible qu'après la construction du site."; };
      document.head.append(s);
    </script>
  </div>
</Base>

<style is:global>
  #search { --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--ink); --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--rule); --pagefind-ui-font: var(--sans); }
</style>
