---
import Base from "../../layouts/Base.astro";
import LivreCard from "../../components/LivreCard.astro";
import { getLivres, nomDeFamille } from "../../lib/bibliotheque";
import { PARCOURS, type ParcoursId } from "../../parcours";

const livres = await getLivres();
const ids = Object.keys(PARCOURS) as ParcoursId[];
const parTitre = (a: { titre: string }, b: { titre: string }) => a.titre.localeCompare(b.titre, "fr");

const parTheme = ids
  .map((id) => ({ id, livres: livres.filter((l) => l.parcours === id).sort((a, b) => a.annee.localeCompare(b.annee, "fr", { numeric: true }) || parTitre(a, b)) }))
  .filter((g) => g.livres.length);

// A book with two authors appears under each of them.
const auteurs = new Map<string, typeof livres>();
for (const l of livres) for (const a of l.auteurs) auteurs.set(a, [...(auteurs.get(a) ?? []), l]);
const parAuteur = [...auteurs].sort(([a], [b]) => nomDeFamille(a).localeCompare(nomDeFamille(b), "fr"));
const commencer = livres.filter((l) => l.incontournable);
const nbCouvertures = livres.filter((l) => l.couverture).length;
---
<Base titre="Bibliothèque · Kratos" description="Toutes les lectures recommandées par les leçons, par thématique ou par auteur.">
  <header class="hero wrap">
    <h1>La <span class="surligne">bibliothèque</span></h1>
    <p class="lede">Les {livres.length} lectures citées dans les leçons : ce que chacune apporte, et la leçon qui s'y appuie.</p>
    <div class="meta">
      <span class="chip">{livres.length} lectures</span>
      <span class="chip">{auteurs.size} auteurs</span>
      <span class="chip">{nbCouvertures} couvertures</span>
    </div>
  </header>

  <div class="wrap outils" data-bibliotheque>
    <label class="recherche">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 105.1 10.5l4.2 4.2 1.4-1.4-4.2-4.2A6.5 6.5 0 0010.5 4z" /></svg>
      <input type="search" placeholder="Titre, auteur, sujet" aria-label="Rechercher dans la bibliothèque" data-recherche />
    </label>
    <div class="segments" role="group" aria-label="Classer par">
      <button type="button" aria-pressed="true" data-vue="theme">Thématique</button>
      <button type="button" aria-pressed="false" data-vue="auteur">Auteur</button>
    </div>
    <div class="filtres" role="group" aria-label="Filtrer par thématique">
      {ids.map((id) => <button type="button" class="chip filtre" data-parcours={id} data-filtre={id} aria-pressed="false">{PARCOURS[id].nom}</button>)}
    </div>
    <p class="vide" data-vide hidden>Aucune lecture ne correspond.</p>

    {commencer.length > 0 && (
      <section class="groupe commencer" aria-labelledby="commencer" data-commencer>
        <h2 id="commencer">Pour commencer</h2>
        <p class="sous">Les {commencer.length} lectures à ouvrir en premier : les textes qui structurent tout le reste.</p>
        <ul class="grille">{commencer.map((livre) => <LivreCard livre={livre} />)}</ul>
      </section>
    )}

    <div data-vue-contenu="theme">
      {parTheme.map((g) => (
        <section class="groupe" data-parcours={g.id}>
          <h2>{PARCOURS[g.id].nom} <span class="chip">{g.livres.length}</span></h2>
          <ul class="grille">{g.livres.map((livre) => <LivreCard livre={livre} />)}</ul>
        </section>
      ))}
    </div>
    <div data-vue-contenu="auteur" hidden>
      {parAuteur.map(([nom, items]) => (
        <section class="groupe auteur-groupe">
          <h2>{nom}</h2>
          <ul class="grille">{items.map((livre) => <LivreCard livre={livre} />)}</ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  const racine = document.querySelector<HTMLElement>("[data-bibliotheque]")!;
  const champ = racine.querySelector<HTMLInputElement>("[data-recherche]")!;
  const vide = racine.querySelector<HTMLElement>("[data-vide]")!;
  const filtres = [...racine.querySelectorAll<HTMLButtonElement>("[data-filtre]")];
  const vues = [...racine.querySelectorAll<HTMLButtonElement>("[data-vue]")];
  let theme = "";

  // Hides tiles that miss the query or the theme, then hides groups left empty.
  function appliquer() {
    const q = champ.value.trim().toLowerCase();
    let visibles = 0;
    racine.querySelectorAll<HTMLElement>(".livre").forEach((el) => {
      const ok = (!q || el.dataset.q!.includes(q)) && (!theme || el.dataset.parcours === theme);
      el.hidden = !ok;
    });
    racine.querySelectorAll<HTMLElement>(".groupe").forEach((g) => {
      const n = g.querySelectorAll(".livre:not([hidden])").length;
      g.hidden = n === 0;
      if (!g.closest("[hidden]")) visibles += n;
    });
    vide.hidden = visibles > 0;
  }
  function vue(nom: string) {
    vues.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.vue === nom)));
    racine.querySelectorAll<HTMLElement>("[data-vue-contenu]").forEach((c) => (c.hidden = c.dataset.vueContenu !== nom));
    appliquer();
  }
  champ.addEventListener("input", appliquer);
  vues.forEach((b) => b.addEventListener("click", () => vue(b.dataset.vue!)));
  filtres.forEach((b) => b.addEventListener("click", () => {
    theme = theme === b.dataset.filtre ? "" : b.dataset.filtre!;
    filtres.forEach((f) => f.setAttribute("aria-pressed", String(f.dataset.filtre === theme)));
    appliquer();
  }));
</script>

<style>
  .wrap { max-width: 64rem; }
  .hero { padding-top: 2.5rem; }
  .hero h1 { font-size: clamp(2.3rem, 7vw, 4.2rem); font-stretch: 118%; }
  .surligne { color: var(--institutions); }
  .outils { display: grid; gap: 1rem; margin-top: 1.5rem; font-family: var(--sans); }
  .recherche { display: flex; align-items: center; gap: 0.7rem; padding: 0 1.2rem; height: 3.5rem; border-radius: 999px; background: var(--surface-2); }
  .recherche:focus-within { outline: 3px solid var(--institutions); outline-offset: 2px; }
  .recherche svg { width: 1.4rem; fill: var(--ink-2); flex: none; }
  .recherche input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: 1rem var(--sans); outline: none; }
  .segments { display: inline-flex; justify-self: start; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--rule); overflow: hidden; }
  .segments button { padding: 0.65rem 1.3rem; border: 0; background: transparent; color: var(--ink-2); font: 700 0.9rem var(--sans); cursor: pointer; min-height: 2.75rem; }
  .segments button + button { border-left: 1px solid var(--rule); }
  .segments button[aria-pressed="true"] { background: var(--institutions-c); color: var(--on-institutions-c); }
  .segments button[aria-pressed="true"]::before { content: "✓ "; }
  .filtres { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filtre { border: 0; cursor: pointer; min-height: 2.25rem; padding: 0.4rem 0.9rem; box-shadow: inset 0 0 0 1px var(--rule); background: transparent; }
  .filtre[aria-pressed="true"] { background: var(--tone-container); color: var(--on-tone-container); box-shadow: none; }
  .filtre[aria-pressed="true"]::before { content: "✓"; }
  .commencer { padding: 1.4rem; border-radius: var(--r-xl); background: var(--surface); }
  .commencer h2 { color: var(--ink); }
  .sous { margin: -0.5rem 0 1rem; color: var(--ink-2); }
  .vide { color: var(--ink-2); }
  .groupe { margin-top: 2rem; }
  .groupe[hidden], .vide[hidden] { display: none; }
  .groupe h2 { margin: 0 0 1rem; display: flex; align-items: center; gap: 0.7rem; color: var(--tone); }
  .groupe h2 .chip { color: var(--ink-2); }
  .auteur-groupe h2 { color: var(--ink); }
  .grille { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.9rem; }
  .grille :global(.livre[hidden]) { display: none; }
</style>
