---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Forme from "../../components/Forme.astro";
import RailLecon from "../../components/RailLecon.astro";
import { PARCOURS } from "../../parcours";

export async function getStaticPaths() {
  const lecons = await getCollection("lecons");
  return lecons.map((l) => ({ params: { slug: l.id }, props: { lecon: l } }));
}

const { lecon } = Astro.props;
const { Content, headings } = await render(lecon);
// Long lessons are split into chapters (h2); a table of contents appears once there are enough of them.
const chapitres = headings.filter((h) => h.depth === 2);
const d = lecon.data;
const p = PARCOURS[d.parcours];
const base = import.meta.env.BASE_URL;
const sources = [...d.sources].sort((a, b) => Number(b.primaire) - Number(a.primaire));
const primaires = d.sources.filter((s) => s.primaire).length;
const secondaires = d.sources.filter((s) => s.secondaire).length;
---
<Base titre={`${d.titre} · Kratos`} description={d.resume}>
  <article data-parcours={d.parcours} data-pagefind-body>
    {chapitres.length >= 3 && <RailLecon chapitres={chapitres} />}
    <header class="hero">
      <Forme nom={p.forme} class="hero-forme" />
      <div class="wrap">
        <a class="chip tone" href={`${base}parcours/${d.parcours}/`}>{p.nom}</a>
        <h1>{d.titre}</h1>
        <p class="lede">{d.resume}</p>
        <div class="meta">
          <span class="chip">{d.lecture_min} min</span>
          <span class="chip">{d.sources.length} sources, dont {primaires} primaires{secondaires > 0 && `, ${secondaires} secondaires`}</span>
          {d.verifie_le
            ? <span class="chip">Vérifiée le {d.verifie_le}</span>
            : <span class="chip warn-chip">Relecture humaine en cours</span>}
        </div>
        <div class="actions">
          <a class="btn" href={`${base}pdf/${lecon.id}.pdf`} download>Télécharger le PDF</a>
        </div>
      </div>
    </header>

    <div class="wrap prose">
      {!d.verifie_le && (
        <p class="warn no-print">
          Brouillon : chaque fait est relié à sa source, mais la relecture humaine, chiffre par chiffre, n'est pas encore faite.
        </p>
      )}

      {chapitres.length >= 5 && (
        <nav class="sommaire callout" aria-label="Sommaire">
          <h2>Sommaire</h2>
          <ol>{chapitres.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ol>
        </nav>
      )}

      <Content />

      {d.lectures.length > 0 && (
        <section class="lectures">
          <h2>Pour aller plus loin</h2>
          <ul>
            {d.lectures.map((l) => (
              <li>
                <span class="titre">{l.auteur}, {l.url ? <a href={l.url}><cite>{l.titre}</cite></a> : <cite>{l.titre}</cite>} ({l.annee})</span>
                <span class="pourquoi">{l.pourquoi}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {d.images.length > 0 && (
        <section>
          <h2>Crédits images</h2>
          <ul>{d.images.map((i) => <li>{i.legende} : {i.auteur}, <a href={i.url}>{i.licence}</a></li>)}</ul>
        </section>
      )}

      <div class="fin no-print" data-fin-lecon>
        <button class="btn" type="button" data-marquer-lue={lecon.id} aria-pressed="false">Marquer comme lue</button>
        <a class="chip" href={`${base}parcours/${d.parcours}/`}>Retour au parcours {p.nom}</a>
      </div>

      <section class="sources">
        <h2>Sources</h2>
        <ol>
          {sources.map((s) => (
            <li>
              {s.primaire && <span class="chip tone">Primaire</span>}
              {s.secondaire && <span class="chip">Secondaire, à recouper</span>}
              <span>{s.auteur}, <a href={s.url}><cite>{s.titre}</cite></a>. Consulté le {s.consulte}.</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </article>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    margin: 12px 12px 0;
    padding: 2.4rem 0 2.6rem;
    border-radius: var(--r-xl);
    background: var(--tone-container);
    color: var(--on-tone-container);
  }
  .hero .wrap { position: relative; }
  .hero .lede { color: inherit; opacity: 0.88; }
  .hero .chip:not(.tone):not(.warn-chip) { background: color-mix(in srgb, var(--bg) 55%, transparent); color: inherit; }
  .hero .btn { background: var(--tone); color: var(--bg); }
  :global(.hero-forme) {
    position: absolute;
    width: min(22rem, 70vw);
    right: max(-6rem, calc(50% - 32rem));
    top: -4rem;
    fill: var(--tone);
    opacity: 0.14;
    animation: tourne 60s linear infinite;
  }
  @keyframes tourne { to { transform: rotate(360deg); } }
  .sommaire { margin: 1.5rem 0 2.5rem; padding: 1.2rem 1.4rem; border-radius: var(--r-l); background: var(--surface); font-family: var(--sans); }
  .sommaire h2 { margin: 0 0 0.6rem; font-size: 1.1rem; }
  .sommaire h2::before { display: none; }
  .sommaire ol { margin: 0; padding-left: 1.6rem; columns: 2 18rem; column-gap: 2rem; }
  .sommaire li { margin: 0.25rem 0; break-inside: avoid; font-size: 0.95rem; }
  .sommaire a { color: inherit; text-decoration-color: var(--tone); }
  .lectures { font: 0.95rem/1.5 var(--sans); }
  .lectures ul { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .lectures li { display: grid; gap: 0.2rem; padding: 0.8rem 1rem; border-radius: var(--r-m); border-left: 4px solid var(--tone); background: var(--surface); }
  .lectures .titre { font-weight: 650; }
  .lectures .pourquoi { color: var(--ink-2); font-size: 0.9rem; }
  .fin { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; margin: 2.5rem 0; font-family: var(--sans); }
  .fin .btn { background: var(--tone); color: var(--bg); border: 0; cursor: pointer; }
  .sources { font: 0.9rem/1.5 var(--sans); }
  .sources ol { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .sources li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; padding: 0.7rem 0.9rem; border-radius: var(--r-m); background: var(--surface); }
  .sources .chip { font-size: 0.7rem; padding: 0.15rem 0.55rem; }
  @media print {
    .hero { margin: 0; padding: 0; background: none; color: inherit; }
    .sources li, .lectures li, .sommaire { background: none; padding: 0.2rem 0; }
  }
</style>
