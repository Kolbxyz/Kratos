---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Forme from "../components/Forme.astro";
import { PARCOURS, type ParcoursId } from "../parcours";

const lecons = (await getCollection("lecons")).sort((a, b) => a.data.ordre - b.data.ordre);
const base = import.meta.env.BASE_URL;
const ids = Object.keys(PARCOURS) as ParcoursId[];
// Tracks with published lessons come first so the reader lands on real content.
const ordre = [...ids].sort(
  (a, b) => Number(lecons.some((l) => l.data.parcours === b)) - Number(lecons.some((l) => l.data.parcours === a)),
);
const nbSources = lecons.reduce((n, l) => n + l.data.sources.length, 0);
---
<Base titre="Leçons de pouvoir" description="Leçons sourcées sur le pouvoir, les institutions, l'économie et la guerre.">
  <section class="hero wrap">
    <div class="hero-texte">
      <h1>Comprendre le pouvoir, <span class="surligne">chiffres et textes à l'appui</span></h1>
      <p class="lede">
        Des leçons de 10 à 15 minutes sur la politique, le droit, l'économie et la guerre.
        Théorie, histoire, données officielles et citations exactes, chaque fois avec la source.
      </p>
      <div class="meta">
        <span class="chip">{lecons.length} leçons</span>
        <span class="chip">{nbSources} sources citées</span>
        <span class="chip">PDF pour chaque leçon</span>
      </div>
    </div>
    <div class="grappe" aria-hidden="true">
      {ids.map((id) => <a href={`#${id}`} tabindex="-1" data-parcours={id}><Forme nom={PARCOURS[id].forme} /></a>)}
    </div>
  </section>

  <nav class="wrap filtres" aria-label="Parcours">
    {ordre.map((id) => <a class="chip" href={`#${id}`} data-parcours={id}><Forme nom={PARCOURS[id].forme} />{PARCOURS[id].nom}</a>)}
  </nav>

  <div class="wrap">
    {ordre.map((id) => {
      const p = PARCOURS[id];
      const items = lecons.filter((l) => l.data.parcours === id);
      return (
        <section class="parcours" id={id} data-parcours={id}>
          <div class="parcours-tete">
            <Forme nom={p.forme} class="parcours-forme" />
            <div>
              <h2>{p.nom}</h2>
              <p class="accroche">{p.accroche}</p>
            </div>
          </div>
          <ul class="cards">
            {items.map((l) => (
              <li class="card">
                <a href={`${base}lecons/${l.id}/`}>
                  <strong>{l.data.titre}</strong>
                  <span>{l.data.resume}</span>
                  <small>
                    <span class="chip">{l.data.lecture_min} min</span>
                    <span class="chip">{l.data.sources.length} sources</span>
                    {!l.data.verifie_le && <span class="chip">Relecture en cours</span>}
                  </small>
                </a>
              </li>
            ))}
            {p.a_venir.map((t) => <li class="card soon"><strong>{t}</strong><small>À venir</small></li>)}
          </ul>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .wrap { max-width: 64rem; }
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; padding-top: 2.5rem; padding-bottom: 1rem; }
  .hero h1 { font-size: clamp(2.3rem, 7vw, 4.2rem); font-stretch: 118%; max-width: 14ch; }
  .surligne { color: var(--institutions); }
  .hero .lede { max-width: 36rem; }
  .grappe { display: grid; grid-template-columns: repeat(2, 7.5rem); gap: 0.6rem; }
  .grappe a { display: block; }
  .grappe :global(.forme) { width: 100%; fill: var(--tone); transition: transform 0.7s var(--spring); }
  .grappe a:nth-child(2) :global(.forme) { transform: rotate(-12deg); }
  .grappe a:nth-child(3) :global(.forme) { transform: rotate(8deg); }
  .grappe a:hover :global(.forme) { transform: rotate(45deg) scale(1.08); }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; }
    .grappe { order: -1; grid-template-columns: repeat(4, 3.2rem); gap: 0.4rem; }
  }

  .filtres { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .filtres .chip { padding: 0.45rem 0.9rem 0.45rem 0.55rem; font-size: 0.88rem; background: var(--tone-container); color: var(--on-tone-container); transition: border-radius 0.35s var(--spring); }
  .filtres .chip:hover { border-radius: var(--r-s); }
  .filtres :global(.forme) { width: 1.2rem; fill: var(--tone); }

  .parcours { margin-top: 3.5rem; }
  .parcours-tete { display: flex; align-items: center; gap: 1rem; }
  .parcours-tete h2 { margin: 0; }
  :global(.parcours-forme) { flex: none; width: 3.4rem; fill: var(--tone); }
  .accroche { color: var(--ink-2); margin: 0.2rem 0 0; font-size: 1rem; }

  .cards { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.8rem; }
  .card { font-family: var(--sans); border-radius: var(--r-l); background: var(--tone-container); color: var(--on-tone-container); transition: border-radius 0.45s var(--spring), transform 0.45s var(--spring); }
  .card:not(.soon):hover { border-radius: var(--r-xl) var(--r-s) var(--r-xl) var(--r-s); transform: translateY(-3px); }
  .card a, .card.soon { display: flex; flex-direction: column; gap: 0.55rem; padding: 1.3rem; height: 100%; color: inherit; text-decoration: none; }
  .card strong { font: 750 1.22rem/1.2 var(--display); font-stretch: 105%; }
  .card span { font-size: 0.92rem; line-height: 1.45; }
  .card small { margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.35rem; padding-top: 0.4rem; }
  .card small .chip { background: color-mix(in srgb, var(--bg) 55%, transparent); color: inherit; font-size: 0.75rem; }
  .card.soon { align-self: start; background: transparent; color: var(--ink-3); border: 2px dashed var(--rule); }
  .card.soon strong { font-size: 1.02rem; font-weight: 650; }
  .card.soon small { font-weight: 600; }
</style>
