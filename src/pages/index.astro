---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Forme from "../components/Forme.astro";
import Medaillon from "../components/Medaillon.astro";
import { PARCOURS, type ParcoursId } from "../parcours";

const lecons = (await getCollection("lecons")).sort((a, b) => a.data.ordre - b.data.ordre);
const base = import.meta.env.BASE_URL;
const ids = Object.keys(PARCOURS) as ParcoursId[];
// Tracks with published lessons come first so the reader lands on real content.
const ordre = [...ids].sort(
  (a, b) => Number(lecons.some((l) => l.data.parcours === b)) - Number(lecons.some((l) => l.data.parcours === a)),
);
const nbSources = lecons.reduce((n, l) => n + l.data.sources.length, 0);
---
<Base titre="Kratos" description="Leçons sourcées sur le pouvoir, les institutions, l'économie et la guerre.">
  <section class="hero wrap">
    <div class="hero-texte">
      <h1>Comprendre les rouages du monde, <span class="surligne">sources à l'appui</span></h1>
      <p class="lede">
        Des leçons longues sur la politique, le droit, l'économie et la guerre : comment les institutions,
        l'argent et la force fonctionnent, avec la source de chaque fait.
      </p>
      <div class="meta">
        <span class="chip">{lecons.length} leçons</span>
        <span class="chip">{nbSources} sources citées</span>
      </div>
    </div>
    <div class="grappe" aria-hidden="true">
      {ids.map((id) => <a href={`${base}parcours/${id}/`} tabindex="-1" data-parcours={id}><Forme nom={PARCOURS[id].forme} /></a>)}
    </div>
  </section>

  <section class="wrap tuiles-zone" aria-label="Parcours">
    <a class="btn continuer" data-continuer data-base={base} data-titres={JSON.stringify(Object.fromEntries(lecons.map((l) => [l.id, l.data.titre])))} href={base} hidden>Reprendre la dernière leçon<span data-nom-lecon></span></a>
    <ul class="tuiles">
      {ordre.map((id) => {
        const p = PARCOURS[id];
        const items = lecons.filter((l) => l.data.parcours === id);
        const h = Math.round(items.reduce((n, l) => n + l.data.lecture_min, 0) / 60);
        return (
          <li data-parcours={id} data-tuile data-ids={items.map((l) => l.id).join(",")}>
            <a href={`${base}parcours/${id}/`}>
              <Medaillon id={id} class="tuile-forme" />
              <strong>{p.nom}</strong>
              <span class="acc">{p.accroche}</span>
              <span class="infos">
                <span class="chip">{items.length} leçons</span>
                <span class="chip">{h} h</span>
                <span class="chip" data-avancement>0/{items.length} lues</span>
              </span>
              <span class="barre" aria-hidden="true"></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  .wrap { max-width: 64rem; }
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; padding-top: 2.5rem; padding-bottom: 1rem; }
  .hero h1 { font-size: clamp(2.3rem, 7vw, 4.2rem); font-stretch: 118%; max-width: 14ch; }
  .surligne { color: var(--institutions); }
  .hero .lede { max-width: 36rem; }
  .grappe { display: grid; grid-template-columns: repeat(2, 7.5rem); gap: 0.6rem; }
  .grappe a { display: block; }
  .grappe :global(.forme) { width: 100%; fill: var(--tone); transition: transform 0.7s var(--spring); }
  .grappe a:nth-child(2) :global(.forme) { transform: rotate(-12deg); }
  .grappe a:nth-child(3) :global(.forme) { transform: rotate(8deg); }
  .grappe a:hover :global(.forme) { transform: rotate(45deg) scale(1.08); }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; }
    .grappe { order: -1; grid-template-columns: repeat(4, 3.2rem); gap: 0.4rem; }
  }

  .tuiles-zone { margin-top: 1.5rem; }
  .continuer { margin-bottom: 1rem; }
  .continuer[hidden] { display: none; }
  .tuiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 0.9rem; font-family: var(--sans); }
  .tuiles li { display: flex; border-radius: var(--r-xl); background: var(--tone-container); color: var(--on-tone-container); overflow: hidden; transition: border-radius 0.45s var(--spring), transform 0.45s var(--spring); }
  .tuiles li:hover { border-radius: var(--r-xl) var(--r-s) var(--r-xl) var(--r-s); transform: translateY(-4px); }
  .tuiles a { flex: 1; position: relative; display: flex; flex-direction: column; gap: 0.6rem; min-height: 15rem; padding: 1.5rem; color: inherit; text-decoration: none; }
  .tuiles :global(.tuile-forme) { width: 4.2rem; }
  .tuiles li:hover :global(.tuile-forme .forme) { transform: rotate(45deg) scale(1.1); }
  .tuiles strong { font: 800 1.5rem/1.15 var(--display); font-stretch: 110%; }
  .acc { font-size: 0.95rem; line-height: 1.45; }
  .infos { margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.35rem; padding-bottom: 0.6rem; }
  .infos .chip { background: color-mix(in srgb, var(--bg) 55%, transparent); color: inherit; font-size: 0.75rem; }
  .barre { position: absolute; left: 0; bottom: 0; height: 0.45rem; width: 100%; background: color-mix(in srgb, var(--bg) 45%, transparent); }
  .barre::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--avancement, 0%); background: var(--tone); border-radius: 0 999px 999px 0; transition: width 0.6s var(--ease-radius); }
</style>
