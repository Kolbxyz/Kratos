---
// Book tile: the cover when Open Library has one, otherwise a tonal cover carrying the track's medallion.
import Medaillon from "./Medaillon.astro";
import { PARCOURS } from "../parcours";
import type { Livre } from "../lib/bibliotheque";
interface Props { livre: Livre; grand?: boolean }
const { livre, grand } = Astro.props;
const base = import.meta.env.BASE_URL;
const theme = PARCOURS[livre.parcours].nom;
// Tile = link to the detail page; lesson titles in data-q make the search match on topics too.
const q = [livre.titre, livre.auteur, theme, ...livre.sujets, ...livre.lecons.map((l) => l.titre)].join(" ").toLowerCase();
---
<li class="livre" data-parcours={livre.parcours} data-q={q} data-annee={livre.annee}>
  <a href={`${base}bibliotheque/${livre.id}/`}>
    <span class="couv">
      {livre.couverture
        ? <img src={`${base}couvertures/${livre.couverture}`} alt={`Couverture : ${livre.titre}`} loading="lazy" decoding="async" />
        : <><span class="couv-auteur">{livre.auteur}</span><span class="couv-titre">{livre.titre.split(/\. |: |\(|, livre|, chapitre/)[0]}</span><Medaillon id={livre.parcours} class="couv-forme" /></>}
    </span>
    <span class="infos">
      <strong>{livre.titre.split(/ \(/)[0]}</strong>
      <span class="auteur">{livre.auteur}</span>
      <span class="puces"><span class="chip">{livre.annee}</span><span class="chip tone">{theme}</span></span>
    </span>
  </a>
</li>
<style>
  .livre { display: flex; border-radius: var(--r-l); background: var(--surface); transition: border-radius 0.45s var(--spring), transform 0.45s var(--spring); }
  .livre:hover { border-radius: var(--r-xl) var(--r-s) var(--r-xl) var(--r-s); transform: translateY(-4px); }
  .livre a { flex: 1; display: flex; flex-direction: column; gap: 0.8rem; padding: 0.7rem 0.7rem 1.1rem; color: inherit; text-decoration: none; font-family: var(--sans); min-width: 0; }
  .couv { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 0.6rem; aspect-ratio: 2 / 3; overflow: hidden; border-radius: var(--r-m); background: var(--tone-container); color: var(--on-tone-container); padding: 1.1rem 1rem 1rem 1.5rem; text-align: left; }
  .couv:not(:has(img))::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 0.5rem; background: var(--tone); }
  .couv img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .couv :global(.couv-forme) { width: 28%; align-self: flex-end; }
  .couv-auteur { font: 700 0.7rem/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8; overflow-wrap: anywhere; }
  .couv-titre { font: 750 1.15rem/1.18 var(--display); font-stretch: 105%; overflow-wrap: anywhere; }
  .infos { display: flex; flex-direction: column; gap: 0.3rem; padding: 0 0.4rem; }
  .infos strong { font: 750 1rem/1.25 var(--display); font-stretch: 105%; overflow-wrap: anywhere; }
  .auteur { font-size: 0.85rem; color: var(--ink-2); }
  .puces { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.3rem; }
</style>
