---
// Flow or organisation chart. Every arrow is numbered and listed below with the text that establishes it,
// so a link between two boxes cannot exist without a clickable source.
import { disposer, LARGEUR, HAUTEUR } from "../lib/schema";
import type { Noeud, Lien } from "../lib/schema";

interface Props {
  titre: string;
  noeuds: Noeud[];
  liens: Lien[];
}
const { titre, noeuds, liens } = Astro.props;
liens.forEach((l, i) => {
  if (!l.source || !l.url) throw new Error(`Schema « ${titre} » : lien ${i + 1} (${l.de} vers ${l.vers}) sans source ou url`);
});

const { places, largeur, hauteur, traits } = disposer(noeuds, liens);
const par = new Map(places.map((p) => [p.id, p]));
---
<figure class="schema callout">
  <figcaption class="titre">{titre}</figcaption>
  <div class="defile">
    <svg viewBox={`0 0 ${largeur} ${hauteur}`} style={`min-width:${Math.min(largeur, 560)}px`} role="img" aria-label={`${titre} : ${places.length} acteurs, ${liens.length} relations détaillées sous le schéma`}>
      <defs>
        <marker id="fleche" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" /></marker>
      </defs>
      {traits.map((t) => <path class="lien" d={t.d} marker-end="url(#fleche)" />)}
      {places.map((p) => (
        <g transform={`translate(${p.x} ${p.y})`}>
          <rect width={LARGEUR} height={HAUTEUR} rx="14" />
          <text x={LARGEUR / 2} y={HAUTEUR / 2 - (p.lignes.length - 1) * 8 + 5} text-anchor="middle">
            {p.lignes.map((t, i) => <tspan x={LARGEUR / 2} dy={i === 0 ? 0 : 16}>{t}</tspan>)}
          </text>
        </g>
      ))}
      {traits.map((t, i) => (
        <g class="badge" transform={`translate(${t.mx} ${t.my})`}>
          <circle r="10" /><text text-anchor="middle" y="4">{i + 1}</text>
        </g>
      ))}
    </svg>
  </div>
  <ol class="liens">
    {liens.map((l) => (
      <li><strong>{par.get(l.de)!.nom}</strong> → <strong>{par.get(l.vers)!.nom}</strong> : {l.verbe}. <a href={l.url}>{l.source}</a></li>
    ))}
  </ol>
</figure>

<style>
  .schema { margin: 2rem 0; font-family: var(--sans); }
  .titre { font: 750 1.08rem/1.3 var(--display); margin-bottom: 0.6rem; }
  .defile { overflow-x: auto; }
  svg { display: block; width: 100%; height: auto; }
  rect { fill: var(--tone-container); }
  text { font: 650 13px var(--display); fill: var(--on-tone-container); }
  .lien { fill: none; stroke: var(--ink-3); stroke-width: 1.6; }
  marker path { fill: var(--ink-3); }
  .badge circle { fill: var(--tone); }
  .badge text { font: 800 11px var(--sans); fill: var(--bg); }
  .liens { margin: 0.8rem 0 0; padding-left: 1.4rem; font-size: 0.88rem; line-height: 1.5; color: var(--ink-2); }
  .liens li { margin-bottom: 0.3rem; }
  .liens strong { color: var(--ink); background: none; padding: 0; }
</style>
