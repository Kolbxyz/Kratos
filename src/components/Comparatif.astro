---
// Two or three entities compared indicator by indicator. CSV columns: entite, indicateur, valeur, unite, periode.
// Each indicator has its own scale (bars are relative to that row's maximum), colours follow the fixed series order.
import Source from "./Source.astro";
import { charger, exigerColonnes, fmt } from "../lib/donnees";

interface Props {
  src: string; // path under data/, e.g. "defense/comparatif-france-allemagne"
  titre: string;
}
const { src, titre } = Astro.props;

const { rows, source } = charger(src);
exigerColonnes(src, rows, ["entite", "indicateur", "valeur", "unite", "periode"]);

const entites = [...new Set(rows.map((r) => String(r.entite)))];
const couleurs = ["var(--series-1)", "var(--series-2)", "var(--series-3)"];
if (entites.length > couleurs.length) throw new Error(`${src}.csv : ${entites.length} entités, maximum ${couleurs.length}`);

const indicateurs = [...new Set(rows.map((r) => String(r.indicateur)))].map((nom) => {
  const lignes = rows.filter((r) => r.indicateur === nom);
  const max = Math.max(...lignes.map((r) => Number(r.valeur)));
  return {
    nom,
    unite: String(lignes[0].unite),
    cases: entites.map((e, i) => {
      const r = lignes.find((l) => l.entite === e);
      if (!r) throw new Error(`${src}.csv : pas de valeur pour ${e} / ${nom}`);
      return { e, i, v: Number(r.valeur), periode: String(r.periode), part: max > 0 ? (100 * Number(r.valeur)) / max : 0 };
    }),
  };
});
---
<figure class="comparatif">
  <figcaption class="titre">{titre}</figcaption>
  <ul class="legende" aria-label="Légende">
    {entites.map((e, i) => <li><span class="pastille" style={`background:${couleurs[i]}`}></span>{e}</li>)}
  </ul>
  {indicateurs.map((ind) => (
    <section class="indicateur">
      <h4>{ind.nom} <span class="unite">({ind.unite})</span></h4>
      {ind.cases.map((c) => (
        <div class="ligne">
          <div class="barre" style={`--part:${c.part}%;--c:${couleurs[c.i]}`} role="img" aria-label={`${c.e} : ${fmt(c.v)} ${ind.unite}`}></div>
          <span class="valeur">{fmt(c.v)}</span><span class="periode">{c.periode}</span>
        </div>
      ))}
    </section>
  ))}
  <Source source={source} />
</figure>

<style>
  .comparatif { margin: 2rem 0; padding: 1.2rem 1.2rem 1rem; background: var(--surface); border-radius: var(--r-l); font-family: var(--sans); }
  .titre { font: 750 1.08rem/1.3 var(--display); margin-bottom: 0.6rem; }
  .legende { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; list-style: none; padding: 0; margin: 0 0 0.8rem; font-size: 0.85rem; color: var(--ink-2); }
  .pastille { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; margin-right: 0.4rem; vertical-align: -0.1rem; }
  .indicateur { margin-top: 0.9rem; }
  h4 { margin: 0 0 0.3rem; font: 700 0.92rem/1.3 var(--display); }
  .unite { font-weight: 500; color: var(--ink-3); }
  .ligne { display: grid; grid-template-columns: 1fr auto 5.5rem; align-items: center; gap: 0.6rem; margin-top: 0.25rem; }
  .barre { height: 0.8rem; border-radius: 999px; background: linear-gradient(90deg, var(--c) var(--part), transparent var(--part)); }
  .valeur { font: 750 0.95rem var(--display); font-variant-numeric: tabular-nums; text-align: right; }
  .periode { font-size: 0.78rem; color: var(--ink-3); }
</style>
